@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-brand">🦆 DuckStore Management</div>
        <nav class="sidebar-nav">
            <NavLink class="nav-item" href="products">Products</NavLink>
            <NavLink class="nav-item" href="campaigns">Discounts</NavLink>
            <NavLink class="nav-item" href="challenges">Challenges</NavLink>
            <AuthorizeView>
                @* Same gate as the resolvers (ADR-0052 §3); a Seller never sees it. *@
                @if (CognitoGroups.CanManageStock(context.User))
                {
                    <NavLink class="nav-item" href="warehouses">Warehouses</NavLink>
                }
            </AuthorizeView>
        </nav>
    </aside>
    <div class="main-area">
        <header class="topbar">
            <LoginDisplay />
        </header>
        <main class="content">
            @Body
        </main>
    </div>
</div>
