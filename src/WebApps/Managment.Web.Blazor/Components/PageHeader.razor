<header class="page-header">
    <div class="page-header-main">
        @if (BackHref is not null)
        {
            <a class="breadcrumb" href="@BackHref">
                <Icon Name="chevron-left" Size="14" /> @BackLabel
            </a>
        }
        <div class="page-title-row">
            @Leading
            <div>
                <h1>@Title</h1>
                @if (Subtitle is not null)
                {
                    <p class="page-subtitle">@Subtitle</p>
                }
            </div>
        </div>
    </div>
    @if (Actions is not null)
    {
        <div class="page-actions">@Actions</div>
    }
</header>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? BackHref { get; set; }
    [Parameter] public string BackLabel { get; set; } = "Back";
    [Parameter] public RenderFragment? Leading { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
