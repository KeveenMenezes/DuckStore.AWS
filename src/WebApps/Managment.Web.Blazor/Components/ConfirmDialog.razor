@if (visible)
{
    <div class="dialog-backdrop" @onclick="() => Close(false)">
        <div class="dialog" role="alertdialog" aria-modal="true" @onclick:stopPropagation="true">
            <div class="dialog-body dialog-confirm">
                <span class="dialog-icon"><Icon Name="alert" Size="20" /></span>
                <div>
                    <h3 class="dialog-title">Are you sure?</h3>
                    <p class="dialog-text">@message</p>
                </div>
            </div>
            <div class="dialog-actions">
                <button class="btn btn-secondary" @onclick="() => Close(false)">Cancel</button>
                <button class="btn btn-danger" @onclick="() => Close(true)">@ConfirmLabel</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string ConfirmLabel { get; set; } = "Delete";

    private bool visible;
    private string message = string.Empty;
    private TaskCompletionSource<bool>? pending;

    public Task<bool> ShowAsync(string text)
    {
        message = text;
        visible = true;
        pending = new TaskCompletionSource<bool>();
        StateHasChanged();
        return pending.Task;
    }

    private void Close(bool confirmed)
    {
        visible = false;
        pending?.TrySetResult(confirmed);
    }
}
