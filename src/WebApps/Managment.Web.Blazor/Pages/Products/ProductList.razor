@page "/"
@page "/products"
@attribute [Authorize]
@inject ProductAdminService Products
@inject NavigationManager Navigation
@inject ImageCdn Cdn

<PageTitle>Products — DuckStore Management</PageTitle>

<PageHeader Title="Products" Subtitle="Manage the catalog, stock, media and nominal prices.">
    <Actions>
        <a class="btn btn-primary" href="products/new"><Icon Name="plus" /> New product</a>
    </Actions>
</PageHeader>

<Banner @bind-Message="banner" />
<Banner @bind-Message="error" Kind="error" />

<section class="card">
    <form class="toolbar" @onsubmit="SearchAsync">
        <div class="search-field">
            <Icon Name="search" />
            <input type="search" placeholder="Search by product name..." aria-label="Search products"
                   @bind="search" @bind:event="oninput" />
        </div>
        <button class="btn btn-secondary" type="submit">Search</button>
        @if (items is { Count: > 0 })
        {
            <span class="toolbar-meta">@items.Count @(items.Count == 1 ? "product" : "products")@(nextToken is not null ? "+" : "")</span>
        }
    </form>

    @if (items is null)
    {
        <div class="table-wrap">
            <table class="data-table">
                <tbody>
                    @for (var i = 0; i < 6; i++)
                    {
                        <tr class="skeleton-row">
                            <td><div class="cell-product"><span class="skeleton skeleton-thumb"></span><span class="skeleton skeleton-line"></span></div></td>
                            <td><span class="skeleton skeleton-line short"></span></td>
                            <td><span class="skeleton skeleton-line short"></span></td>
                            <td><span class="skeleton skeleton-line short"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (items.Count == 0)
    {
        <EmptyState Title="No products found"
                    Description="@EmptyDescription"
                    IconName="box" />
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Stock</th>
                        <th class="num">Price</th>
                        <th>Rating</th>
                        <th class="col-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in items)
                    {
                        <tr>
                            <td>
                                <a class="cell-product" href="products/@product.Id/edit">
                                    <img class="thumb" src="@Cdn.ThumbOrPlaceholder(product.Images)" alt="" loading="lazy"
                                         onerror="this.onerror=null;this.src='@ImageCdn.Placeholder'" />
                                    <span class="cell-product-text">
                                        <span class="cell-product-name">@product.Name</span>
                                        <span class="cell-product-id">@ShortId(product.Id)</span>
                                    </span>
                                </a>
                            </td>
                            <td><span class="badge @StockBadge(product.Stock)">@StockLabel(product.Stock)</span></td>
                            <td class="num">@((nominalPrices.GetValueOrDefault(product.Id) ?? product.Price).ToString("C"))</td>
                            <td>
                                @if (product.RatingCount == 0)
                                {
                                    <span class="muted">No reviews</span>
                                }
                                else
                                {
                                    <span class="rating">
                                        <Icon Name="star" Size="14" Class="rating-star" />
                                        @product.AverageRating.ToString("0.0")
                                        <span class="muted">(@product.RatingCount)</span>
                                    </span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a class="btn btn-ghost btn-icon" href="products/@product.Id/edit"
                                       title="Edit" aria-label="Edit @product.Name"><Icon Name="edit" /></a>
                                    <button class="btn btn-ghost btn-icon" title="Pricing details"
                                            aria-label="Pricing details for @product.Name"
                                            @onclick="() => priceDialog.Show(product)"><Icon Name="tag" /></button>
                                    <button class="btn btn-ghost btn-icon btn-ghost-danger" title="Delete"
                                            aria-label="Delete @product.Name"
                                            @onclick="() => DeleteAsync(product)"><Icon Name="trash" /></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (nextToken is not null)
        {
            <div class="card-footer">
                <button class="btn btn-secondary" disabled="@loadingMore" @onclick="LoadMoreAsync">
                    @(loadingMore ? "Loading..." : "Load more")
                </button>
            </div>
        }
    }
</section>

<ConfirmDialog @ref="confirmDialog" />
<PriceDetailsDialog @ref="priceDialog" />

@code {
    private List<Product>? items;
    private Dictionary<string, double?> nominalPrices = [];
    private string? nextToken;
    private string search = string.Empty;
    private string? banner;
    private string? error;
    private bool loadingMore;
    private ConfirmDialog confirmDialog = default!;
    private PriceDetailsDialog priceDialog = default!;

    [SupplyParameterFromQuery] public string? Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        banner = Saved switch
        {
            "created" => "Product created — the catalog list syncs asynchronously and may take a few seconds to update.",
            "updated" => "Product updated — the catalog list syncs asynchronously and may take a few seconds to update.",
            _ => null,
        };
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = null;
        items = null;
        nominalPrices = [];
        try
        {
            var page = await Products.GetProductsAsync(search);
            items = page.Items;
            nextToken = page.NextToken;
            nominalPrices = await Products.GetNominalPricesAsync(items.Select(p => p.Id));
        }
        catch (Exception ex)
        {
            items = [];
            error = $"Failed to load products: {ex.Message}";
        }
    }

    private Task SearchAsync() => LoadAsync();

    private async Task LoadMoreAsync()
    {
        loadingMore = true;
        try
        {
            var page = await Products.GetProductsAsync(search, nextToken: nextToken);
            items!.AddRange(page.Items);
            nextToken = page.NextToken;
            var newPrices = await Products.GetNominalPricesAsync(page.Items.Select(p => p.Id));
            foreach (var (id, price) in newPrices)
                nominalPrices[id] = price;
        }
        catch (Exception ex)
        {
            error = $"Failed to load more products: {ex.Message}";
        }
        finally
        {
            loadingMore = false;
        }
    }

    private async Task DeleteAsync(Product product)
    {
        if (!await confirmDialog.ShowAsync($"Delete \"{product.Name}\"? This cannot be undone."))
            return;

        try
        {
            await Products.DeleteProductAsync(product.Id);
            items!.Remove(product);
            banner = "Product deleted";
            error = null;
        }
        catch (Exception ex)
        {
            error = $"Failed to delete product: {ex.Message}";
        }
    }

    private string EmptyDescription => string.IsNullOrWhiteSpace(search)
        ? "Create your first product to get started."
        : $"Nothing matches “{search}”. Try a different search term.";

    private static string ShortId(string id) => id.Length > 8 ? $"#{id[..8]}" : $"#{id}";

    private static string StockBadge(int stock) => stock switch
    {
        0 => "badge-danger",
        <= 5 => "badge-warning",
        _ => "badge-neutral",
    };

    private static string StockLabel(int stock) => stock == 0 ? "Out of stock" : $"{stock} in stock";
}
