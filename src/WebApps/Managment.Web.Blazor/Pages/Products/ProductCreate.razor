@page "/products/new"
@attribute [Authorize]
@inject ProductAdminService Products
@inject NavigationManager Navigation

<PageTitle>New product — DuckStore Management</PageTitle>

<PageHeader Title="New product" Subtitle="Images upload while you fill in the rest of the form."
            BackHref="products" BackLabel="Products" />

<Banner @bind-Message="error" Kind="error" />

<ProductForm Model="model" OnValidSubmit="CreateAsync" SubmitLabel="Create" Busy="busy" />

@code {
    private readonly ProductFormModel model = new();
    private bool busy;
    private string? error;

    private async Task CreateAsync()
    {
        busy = true;
        error = null;
        try
        {
            await Products.CreateProductAsync(model);
            Navigation.NavigateTo("products?saved=created");
        }
        catch (Exception ex)
        {
            error = $"Failed to create product: {ex.Message}";
            busy = false;
        }
    }
}
