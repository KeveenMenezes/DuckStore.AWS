@page "/campaigns"
@attribute [Authorize]
@using System.Globalization
@inject CampaignAdminService Campaigns

<PageTitle>Discounts — DuckStore Management</PageTitle>

<PageHeader Title="Discounts" Subtitle="Promotional campaigns applied by Pricing to selected products.">
    <Actions>
        <a class="btn btn-primary" href="campaigns/new"><Icon Name="plus" /> New campaign</a>
    </Actions>
</PageHeader>

<Banner @bind-Message="banner" />
<Banner @bind-Message="error" Kind="error" />

<section class="card">
    @if (items is null)
    {
        <p class="card-loading muted">Loading campaigns...</p>
    }
    else if (items.Count == 0)
    {
        <EmptyState Title="No campaigns yet" IconName="percent"
                    Description="Create a campaign to discount one or more products for a period." />
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Campaign</th>
                        <th>Discount</th>
                        <th>Period</th>
                        <th class="num">Products</th>
                        <th>Status</th>
                        <th class="col-actions"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var campaign in items)
                    {
                        var status = DisplayStatus(campaign);
                        <tr>
                            <td><span class="cell-product-name">@campaign.Name</span></td>
                            <td><span class="badge badge-accent">@FormatDiscount(campaign)</span></td>
                            <td class="nowrap">@FormatDate(campaign.StartsAt) – @FormatDate(campaign.EndsAt)</td>
                            <td class="num">@campaign.ProductIds.Count</td>
                            <td><span class="badge badge-dot @StatusBadge(status)">@status</span></td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    @if (CanEnd(campaign))
                                    {
                                        <button class="btn btn-secondary btn-sm btn-ghost-danger" @onclick="() => EndAsync(campaign)">End</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (nextToken is not null)
        {
            <div class="card-footer">
                <button class="btn btn-secondary" disabled="@loadingMore" @onclick="LoadMoreAsync">
                    @(loadingMore ? "Loading..." : "Load more")
                </button>
            </div>
        }
    }
</section>

<ConfirmDialog @ref="confirmDialog" ConfirmLabel="End campaign" />

@code {
    private List<Campaign>? items;
    private string? nextToken;
    private string? banner;
    private string? error;
    private bool loadingMore;
    private ConfirmDialog confirmDialog = default!;

    [SupplyParameterFromQuery] public string? Saved { get; set; }

    protected override async Task OnInitializedAsync()
    {
        banner = Saved switch
        {
            "created" => "Campaign created",
            _ => null,
        };
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        error = null;
        items = null;
        try
        {
            var page = await Campaigns.GetCampaignsAsync();
            items = page.Items;
            nextToken = page.NextToken;
        }
        catch (Exception ex)
        {
            items = [];
            error = $"Failed to load campaigns: {ex.Message}";
        }
    }

    private async Task LoadMoreAsync()
    {
        loadingMore = true;
        try
        {
            var page = await Campaigns.GetCampaignsAsync(nextToken: nextToken);
            items!.AddRange(page.Items);
            nextToken = page.NextToken;
        }
        catch (Exception ex)
        {
            error = $"Failed to load more campaigns: {ex.Message}";
        }
        finally
        {
            loadingMore = false;
        }
    }

    private async Task EndAsync(Campaign campaign)
    {
        if (!await confirmDialog.ShowAsync($"End campaign \"{campaign.Name}\"? This cannot be undone."))
            return;

        try
        {
            await Campaigns.EndCampaignAsync(campaign.Id);
            var index = items!.IndexOf(campaign);
            items[index] = campaign with { Status = "Cancelled" };
            banner = "Campaign ended";
            error = null;
        }
        catch (Exception ex)
        {
            error = $"Failed to end campaign: {ex.Message}";
        }
    }

    private static string FormatDiscount(Campaign campaign) => campaign.DiscountType switch
    {
        "Percentage" => $"{campaign.Value:0.##}% off",
        _ => $"{campaign.Value:C} off",
    };

    private static string FormatDate(string iso) =>
        DateTime.Parse(iso, null, DateTimeStyles.RoundtripKind).ToLocalTime().ToString("d");

    private static string DisplayStatus(Campaign campaign)
    {
        if (campaign.Status == "Cancelled") return "Cancelled";

        var now = DateTime.UtcNow;
        var startsAt = DateTime.Parse(campaign.StartsAt, null, DateTimeStyles.RoundtripKind);
        var endsAt = DateTime.Parse(campaign.EndsAt, null, DateTimeStyles.RoundtripKind);

        if (now > endsAt) return "Expired";
        if (now < startsAt) return "Scheduled";
        return "Active";
    }

    private static bool CanEnd(Campaign campaign) =>
        campaign.Status == "Active" && DisplayStatus(campaign) != "Expired";

    private static string StatusBadge(string status) => status switch
    {
        "Active" => "badge-success",
        "Scheduled" => "badge-info",
        "Cancelled" => "badge-danger",
        _ => "badge-neutral",
    };
}
