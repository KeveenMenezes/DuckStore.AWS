{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["es2020"],
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "outDir": "./dist"
  },
  "include": ["bin/**/*.ts", "stacks/**/*.ts", "constructs/**/*.ts"],
  "exclude": ["node_modules", "dist", "cdk.out"]
}
