        <mxCell id="m-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#232F3E;whiteSpace=wrap;" value="DuckStore — AWS Serverless Architecture&lt;br&gt;&lt;font style=&quot;font-size:14px;font-weight:normal;color:#5A6C86&quot;&gt;System overview · 10 bounded contexts · async via EventBridge (ADR-0004) and CDC through DynamoDB Streams (ADR-0005) · &lt;b&gt;per-resource detail lives on each context page&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="70" width="1800" x="60" y="25" as="geometry" />
        </mxCell>
        <mxCell id="m-legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#232F3E;whiteSpace=wrap;rounded=1;arcSize=6;strokeColor=#AAB7B8;fillColor=#F7F8F8;spacing=12;" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#232F3E&quot;&gt;━━&lt;/font&gt; Synchronous request (client → AppSync → data)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#8C4FFF&quot;&gt;━━&lt;/font&gt; Orchestration — saga (Step Functions)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1A7F5A&quot;&gt;━━&lt;/font&gt; Integration event (CDC → EventBridge → consumer)&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#C0392B&quot;&gt;━━&lt;/font&gt; Failure and alert&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#879196&quot;&gt;╌╌&lt;/font&gt; Support / authentication" vertex="1">
          <mxGeometry height="60" width="2180" x="60" y="1700" as="geometry" />
        </mxCell>
