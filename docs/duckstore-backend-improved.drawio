        <mxCell id="n-title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;whiteSpace=wrap;" value="Notification — Go service&lt;br&gt;&lt;font style=&quot;font-size:13px;font-weight:normal;color:#5A6C86&quot;&gt;src/Services/Notification/Notification.Go · the only non-.NET backend service · &lt;b&gt;no stack in infra/&lt;/b&gt;&lt;/font&gt;" vertex="1">
