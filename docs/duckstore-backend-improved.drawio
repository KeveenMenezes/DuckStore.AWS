        <mxCell id="m-api-note" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#5A6C86;whiteSpace=wrap;rounded=1;arcSize=8;strokeColor=#AAB7B8;fillColor=#FFFFFF;spacing=10;dashed=1;" value="&lt;b&gt;AppSync is the only client entry point in every environment (ADR-0023).&lt;/b&gt;&lt;br&gt;Every context below is reached from here — a direct DynamoDB resolver by default, a Lambda only when ADR-0009 requires it. &lt;i&gt;createProductWithPrice&lt;/i&gt; is the one field that resolves into a Step Functions saga." vertex="1">
          <mxGeometry height="100" width="700" x="790" y="520" as="geometry" />
        </mxCell>
        <mxCell id="m-c-catalog" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Catalog&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— CatalogStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;products · categories&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes ProductCreatedEvent · ProductUpdatedEvent · ProductSyncedEvent · ProductDeletedEvent · CatalogCategorySyncEvent&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="100" y="690" as="geometry" />
        </mxCell>
        <mxCell id="m-c-basket" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Basket&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— BasketStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;shopping-carts (USER# / GUEST#)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes BasketCheckoutEvent&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="520" y="690" as="geometry" />
        </mxCell>
        <mxCell id="m-c-review" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Review&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— ReviewStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;reviews (rating delta)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes ReviewCreatedEvent · ReviewUpdatedEvent&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="940" y="690" as="geometry" />
        </mxCell>
        <mxCell id="m-c-challenges" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Challenges&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— ChallengesStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;challenges · challenge-progress&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes ChallengeAnsweredEvent · PointsRedeemedEvent&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="1360" y="690" as="geometry" />
        </mxCell>
        <mxCell id="m-c-pricing" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Pricing&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— PricingStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;prices · campaigns · gateway-costs · customer-discounts&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes PriceChangedEvent · ProductDiscountChangedEvent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▼ consumes ProductDeletedEvent · PointsRedeemedEvent · PaymentAuthorizedEvent&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="1780" y="690" as="geometry" />
        </mxCell>
        <mxCell id="m-c-catalogview" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;CatalogView&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— CatalogViewStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;catalogview-products — every catalog read&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes CatalogViewProductSyncedEvent · CatalogViewProductDeletedEvent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▼ consumes Catalog · Review · Pricing events&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="100" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="m-c-ordering" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Ordering&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— OrderingStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;ordering (one item per order)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes OrderCreatedEvent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▼ consumes BasketCheckoutEvent · PaymentAuthorizedEvent / PaymentDeclinedEvent&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="520" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="m-c-payment" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Payment&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— PaymentStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;payments · + PaymentGateway (stateless)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▲ publishes PaymentRequestedEvent · PaymentAuthorizedEvent / PaymentDeclinedEvent&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▼ consumes BasketCheckoutEvent&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="940" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="m-c-user" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#ED7100;strokeWidth=2;fillColor=#FFF8F2;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#B25600;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;User&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— UserStack&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;user-profiles — direct resolvers, no Lambda&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="1360" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="m-c-notification" parent="1" style="rounded=1;arcSize=6;dashed=1;dashPattern=8 5;strokeColor=#879196;strokeWidth=2;fillColor=#F7F8F8;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;fontColor=#5A6C86;fontSize=13;fontStyle=0;html=1;whiteSpace=wrap;" value="&lt;b&gt;Notification&lt;/b&gt; &lt;font style=&quot;font-size:11px;color:#5A6C86&quot;&gt;— Go · outside the CDK app&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#232F3E&quot;&gt;provisions its own queue and tables at runtime&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#116045&quot;&gt;▼ consumes events → DynamoDB&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="1780" y="1060" as="geometry" />
        </mxCell>
