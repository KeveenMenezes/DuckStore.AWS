        </mxCell>
        <mxCell id="e41" edge="1" parent="1" source="rw-debit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;jettySize=16;strokeColor=#1A7F5A;flowAnimation=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;" target="pr-issue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e42" edge="1" parent="1" source="pr-issue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;jettySize=16;strokeColor=#879196;dashed=1;dashPattern=8 5;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="pr-valid">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="4470" y="1225.05" />
              <mxPoint x="1900" y="1225.05" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e42l" connectable="0" parent="e42" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#FFFFFF;" value="the voucher can be spent on the next purchase" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-1070" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="note-wait" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F7F8F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;Why the customer does not wait for the card.&lt;/b&gt; The moment the purchase is confirmed, the cart becomes an order and the shop answers straight away. Approving the charge happens afterwards, on its own: the order sits as pending until the card provider replies, and is then confirmed or cancelled.&lt;br&gt;That is what the two box colours mean &amp;#8212; white is a step the customer is waiting on, green is a step that runs after they have already been answered." vertex="1">
          <mxGeometry height="130" width="2100" x="230" y="2440" as="geometry" />
        </mxCell>
        <mxCell id="note-gaps" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#F7F8F8;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="&lt;b&gt;What this process deliberately does not do.&lt;/b&gt; A refused payment does not spend the reward voucher: the voucher stays valid, because a refusal must not cost the customer their reward. A customer may rate any product, whether or not they bought it.&lt;br&gt;Points are spent the instant they are exchanged, but the voucher they buy appears shortly afterwards, so nothing is lost if that takes a moment. And once an order is confirmed or cancelled, a repeated answer from the card provider changes nothing." vertex="1">
          <mxGeometry height="130" width="2280" x="2420" y="2440" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;whiteSpace=wrap;rounded=1;arcSize=6;strokeColor=#AAB7B8;fillColor=#F7F8F8;spacing=12;" value="&lt;b&gt;Legend&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#5A6C86&quot;&gt;&amp;#9647;&lt;/font&gt; the customer is waiting for this step&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1A7F5A&quot;&gt;&amp;#9647;&lt;/font&gt; happens on its own, after the customer has been answered&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#D68910&quot;&gt;&amp;#9670;&lt;/font&gt; decision&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#232F3E&quot;&gt;&amp;#9473;&amp;#9473;&lt;/font&gt; main path&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#1A7F5A&quot;&gt;&amp;#9473;&amp;#9473;&lt;/font&gt; carries on without the customer&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#C0392B&quot;&gt;&amp;#9473;&amp;#9473;&lt;/font&gt; refusal or dead end&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#879196&quot;&gt;&amp;#9548;&amp;#9548;&lt;/font&gt; supporting link" vertex="1">
          <mxGeometry height="70" width="4470" x="230" y="2610" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
